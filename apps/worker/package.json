{
  "name": "@repo/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local worker (every queue; the only consumer of triage) and the operations CLIs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
