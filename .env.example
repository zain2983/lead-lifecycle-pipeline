# Copy to .env (never commit it). Which runtime needs which variable:
#
# | Variable                    | web | booking | Actions | local worker | Sim |
# |-----------------------------|-----|---------|---------|--------------|-----|
# | DATABASE_URL                |  x  |    x    |    x    |      x       |     |
# | DIRECT_URL                  |     |         |    x    |      x       |     |
# | PUBLIC_BASE_URL             |  x  |    x    |         |      x       |     |
# | HUBSPOT_CLIENT_ID / _SECRET |  x  |         |    x    |      x       |     |
# | HUBSPOT_REDIRECT_URI        |  x  |         |    x    |      x       |     |
# | HUBSPOT_OAUTH_TOKEN_URL     | (o) |         |   (o)   |     (o)      |     |
# | PUBLIC_WEBHOOK_URL          |  x  |         |         |      x       |     |
# | HUBSPOT_WEBHOOK_CAPTURE_DIR | (o) |         |         |              |     |
# | TOKEN_ENCRYPTION_KEY        |  x  |         |    x    |      x       |     |
# | HUBSPOT_SERVICE_KEY_DEMO    |     |         |    x    |      x       |  x  |
# | HUBSPOT_SERVICE_KEY_EVAL    |     |         |    x    |      x       |     |
# | SIM_BASE_URL / SIM_API_KEY  |     |         |         |      x       |     |
# | SIM_WORKSPACE_ID            |     |         |         |      x       |     |
# | SIM_TRIAGE_WORKFLOW_ID      |     |         |         |      x       |     |
# | SIM_APPROVAL_SECRET         |  x  |         |         |              |  x  |
# | SPIKE_ROUTES                | (x) |         |         |              |     |
#
# "Sim" means the value is entered in Sim's own settings (service key, notification header), not read from this file.
# "(x)" means a one-off spike check only (local, or one Vercel deploy): unset it right after.
# "(o)" means optional (HUBSPOT_WEBHOOK_CAPTURE_DIR: local web only, never on Vercel). The local worker reads
# PUBLIC_WEBHOOK_URL only for `pnpm hs:replay`.

# --- Database ---------------------------------------------------------------------------------------
# Local: infra/docker-compose.yml (pnpm db:up). Production: Supabase transaction pooler :6543 for
# DATABASE_URL and session pooler :5432 for DIRECT_URL. Never use db.<ref>.supabase.co (IPv6 only).
DATABASE_URL=postgresql://app:app@localhost:5433/app
DIRECT_URL=postgresql://app:app@localhost:5433/app

# --- App --------------------------------------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:3100

# --- HubSpot (developer-platform project app, OAuth) ------------------------------------------------
# Project -> app -> Auth tab. The secret also signs webhooks (signature v3) and `pnpm hs:replay`.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Must be one of the app's redirectUrls exactly (integrations/hubspot-app/*/src/app/app-hsmeta.json).
HUBSPOT_REDIRECT_URI=http://localhost:3100/api/hubspot/oauth/callback
# Optional. Defaults to https://api.hubapi.com/oauth/v3/token; tests point it at a local fake.
# HUBSPOT_OAUTH_TOKEN_URL=
# The exact URL HubSpot calls: the quick-tunnel URL locally, the production URL on Vercel.
PUBLIC_WEBHOOK_URL=http://localhost:3100/api/webhooks/hubspot
# Optional, local live tests only: absolute directory outside the repo; each delivery is saved there as
# received. Never set it on Vercel.
# HUBSPOT_WEBHOOK_CAPTURE_DIR=
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Service keys (Development -> Keys -> Service keys) for the two developer test accounts.
HUBSPOT_SERVICE_KEY_DEMO=
HUBSPOT_SERVICE_KEY_EVAL=

# --- Sim (self-hosted, see infra/sim and sim/README.md) --------------------------------------------
# A personal API key from the local instance (infra/sim/bootstrap.sh prints one). Only the local worker uses it.
SIM_BASE_URL=http://localhost:3000
SIM_API_KEY=
SIM_WORKSPACE_ID=
SIM_TRIAGE_WORKFLOW_ID=
# openssl rand -hex 24
SIM_APPROVAL_SECRET=

# --- Spikes (Phase 1 only) --------------------------------------------------------------------------
# "1" turns on /api/spikes/* in apps/web. Anything else, or unset, is off (404). Spike checks only.
SPIKE_ROUTES=0
