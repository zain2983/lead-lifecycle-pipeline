// Prisma 7 schema. The connection URL lives in prisma.config.ts, not here.
// Never run `prisma db pull`: pg-boss owns the `pgboss` schema in the same database, and Prisma only
// manages the default `public` schema. PLAN.md section 6 lists the tables; Phase 2 adds the ones the
// triage agent needs, Phase 8 adds the rest (sessions, consent, identifiers, conversions, deliveries,
// corrections, reconciliation).
//
// Conventions:
// - Tables and columns are snake_case through @@map / @map. Domain timestamps are timestamptz.
// - IDs and timestamps default in the database (gen_random_uuid(), now()), so raw SQL such as the Phase 3
//   `INSERT … ON CONFLICT DO NOTHING` works without Prisma filling them in. Seeds pass deterministic IDs.
// - Postgres enums hold closed sets this project defines (disposition, mode, decision, vertical, split).
// - Values another system controls stay text: HubSpot's subscription types and change sources (HubSpot adds
//   new ones), and run statuses that mirror Sim's. Where the set is ours, the migration adds a CHECK
//   constraint (Prisma can't declare one, and `migrate dev` doesn't drop what it doesn't model).
// - The README's "Data model" ERD is generated from this file: `pnpm --filter @repo/db erd`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Written by every runtime that touches the database (sweeper, worker, web). Keeps the free Postgres
/// project from pausing, and shows when each runtime last ran.
model Heartbeat {
  id        BigInt   @id @default(autoincrement())
  source    String
  detail    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([source, createdAt])
  @@map("heartbeat")
}

/// One HubSpot install (OAuth) per portal. The refresh token is encrypted with AES-256-GCM
/// (TOKEN_ENCRYPTION_KEY, associated data bound to the portal ID; see @repo/crm-hubspot token-crypto).
/// The access token is not stored: it lives 30 minutes and is fetched again with the refresh token.
model OAuthToken {
  id                     BigInt    @id @default(autoincrement())
  /// HubSpot `hub_id` from the token response.
  portalId               BigInt    @unique @map("portal_id")
  refreshTokenCiphertext Bytes     @map("refresh_token_ciphertext")
  refreshTokenIv         Bytes     @map("refresh_token_iv")
  refreshTokenAuthTag    Bytes     @map("refresh_token_auth_tag")
  /// Scopes HubSpot granted, as returned by the token endpoint.
  scopes                 String[]
  accessTokenExpiresAt   DateTime? @map("access_token_expires_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@map("oauth_token")
}

// --- Enums ------------------------------------------------------------------------------------------

/// Business type of a (fictional) demo property. Same values as `@repo/synthetic` verticals.
enum Vertical {
  b2b_saas
  rehab
  clinic
  local_services

  @@map("vertical")
}

/// The triage agent's label set, and the HubSpot `triage_disposition` property's options.
enum TriageDisposition {
  qualified
  nurture
  spam
  duplicate
  needs_review

  @@map("triage_disposition")
}

/// How a lead reached us. `hubspot_direct`: the contact was created in HubSpot (seeded, imported or typed
/// in) and the `object.creation` webhook made the row (PLAN Phase 3.3).
enum LeadSource {
  web_form
  hubspot_direct

  @@map("lead_source")
}

/// `shadow` proposes and stops (no Human block, no write); `propose` waits for an approval.
enum AgentRunMode {
  shadow
  propose

  @@map("agent_run_mode")
}

enum ApprovalDecision {
  approved
  rejected

  @@map("approval_decision")
}

/// `dev` is iterated on; `test` is held out and only scored by the gate.
enum EvalSplit {
  dev
  test

  @@map("eval_split")
}

// --- Domain -----------------------------------------------------------------------------------------

/// A demo property. Fictional names and reserved domains only (`*.test`, example.com).
model Site {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stable slug used in code and URLs (`saas`, `rehab`, …).
  key           String   @unique
  name          String
  domain        String   @unique
  vertical      Vertical
  /// IANA zone the site's own clock runs in (leads are stamped with it).
  timeZone      String   @map("time_zone")
  /// Sensitive vertical: no health words in notes, Limited Data Use, no userData to ad platforms.
  sensitive     Boolean  @default(false)
  /// Per-site routing rules (rule version, destinations, value table). Shape owned by @repo/core routing.
  routingConfig Json     @default("{}") @map("routing_config")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  leads Lead[]

  @@map("site")
}

/// One form submission, or one contact created directly in HubSpot. The public demo accepts only reserved
/// email domains. PII columns are nullable so `contact.privacyDeletion` can purge them and keep the row.
model Lead {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Null for contacts created directly in HubSpot, until a site can be inferred.
  siteId            String?            @map("site_id") @db.Uuid
  /// The attribution session handle. No relation yet: `AttributionSession` arrives in Phase 8.
  sessionId         String?            @map("session_id") @db.Uuid
  source            LeadSource
  /// Made in the browser at submit and reused as the Pixel `eventID`, CAPI `event_id` and Data Manager
  /// `transactionId` (Phase 8). Null for `hubspot_direct` leads.
  browserEventId    String?            @unique @map("browser_event_id") @db.Uuid
  /// Lower-cased. Null only after a privacy deletion.
  email             String?
  firstName         String?            @map("first_name")
  lastName          String?            @map("last_name")
  /// As submitted (synthetic data uses `+1 555-01xx`). Normalised and hashed per destination in Phase 8.
  phone             String?
  companyName       String?            @map("company_name")
  jobTitle          String?            @map("job_title")
  message           String?
  /// The validated form payload exactly as received (hidden fields included).
  submission        Json?
  /// The instant, in UTC.
  submittedAt       DateTime           @map("submitted_at") @db.Timestamptz(3)
  /// IANA zone the submission was stamped in (the site's), and the local wall time it showed, as ISO 8601
  /// with offset. Kept as text so the local date never depends on a later tz-database update.
  submittedTimeZone String             @map("submitted_time_zone")
  submittedAtLocal  String             @map("submitted_at_local")
  hubspotPortalId   BigInt?            @map("hubspot_portal_id")
  hubspotContactId  BigInt?            @map("hubspot_contact_id")
  /// The approved disposition (the HubSpot `triage_disposition` value). Never set by a proposal alone.
  triageDisposition TriageDisposition? @map("triage_disposition")
  dispositionAt     DateTime?          @map("disposition_at") @db.Timestamptz(3)
  /// Key of the `@repo/synthetic` record that produced this lead (every lead is synthetic in this repo).
  syntheticKey      String?            @unique @map("synthetic_key")
  piiPurgedAt       DateTime?          @map("pii_purged_at") @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  site      Site?      @relation(fields: [siteId], references: [id], onDelete: Restrict)
  crmEvents CrmEvent[]
  agentRuns AgentRun[]

  @@unique([hubspotPortalId, hubspotContactId])
  @@index([email])
  @@index([siteId, submittedAt])
  @@map("lead")
}

/// Every HubSpot webhook event, stored once. HubSpot's `eventId` is not unique and retries resend the
/// same event with a higher `attemptNumber`, so `dedupeKey` (see `crmEventDedupeKey` in
/// @repo/crm-hubspot) hashes the fields that identify the change and leaves `attemptNumber` out.
/// Insert with ON CONFLICT (dedupe_key) DO NOTHING in the same transaction as the job (Phase 3.3).
model CrmEvent {
  id               BigInt   @id @default(autoincrement())
  /// `v1:` + sha256 hex of [portalId, subscriptionId, subscriptionType, objectId, propertyName,
  /// propertyValue, occurredAt, eventId].
  dedupeKey        String   @unique @map("dedupe_key")
  portalId         BigInt   @map("portal_id")
  appId            BigInt?  @map("app_id")
  subscriptionId   BigInt   @map("subscription_id")
  /// `object.creation`, `contact.propertyChange`, … (HubSpot's names, kept as text).
  subscriptionType String   @map("subscription_type")
  /// `object.*` events only, e.g. `0-1` for contacts.
  objectTypeId     String?  @map("object_type_id")
  objectId         BigInt   @map("object_id")
  propertyName     String?  @map("property_name")
  propertyValue    String?  @map("property_value")
  eventId          BigInt   @map("event_id")
  /// When the change happened in HubSpot. Events arrive out of order: order by this, never by id.
  occurredAt       DateTime @map("occurred_at") @db.Timestamptz(3)
  /// HubSpot's `changeSource` (`CRM_UI`, `INTEGRATION`, `API`, …). Routing skips our own writes.
  changeSource     String?  @map("change_source")
  sourceId         String?  @map("source_id")
  /// The attempt that was stored first (later attempts collide on dedupe_key).
  attemptNumber    Int      @map("attempt_number")
  /// The event exactly as received.
  rawPayload       Json     @map("raw_payload")
  receivedAt       DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  leadId           String?  @map("lead_id") @db.Uuid

  lead      Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  agentRuns AgentRun[]

  @@index([portalId, objectId, occurredAt])
  @@index([leadId])
  @@map("crm_event")
}

/// One triage run on Sim. `proposalRunId` is the `X-Run-Id` we send (`triage_<sha256(crmEventKey|version)>`),
/// so a queue retry hits the unique index and Sim's 409 instead of starting a second run. A resume gets a
/// new run ID that Sim assigns, so `resumeRunId` is filled in from Sim's answer.
model AgentRun {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId              String             @map("lead_id") @db.Uuid
  /// The webhook event that triggered the run, when there was one.
  crmEventId          BigInt?            @map("crm_event_id")
  /// Sim workflow ID and the deployed version that ran (`run.version`).
  workflowId          String             @map("workflow_id")
  workflowVersion     Int                @map("workflow_version")
  mode                AgentRunMode
  proposalRunId       String             @unique @map("proposal_run_id")
  resumeRunId         String?            @unique @map("resume_run_id")
  /// sha256 of the snapshot sent as input (data minimisation: allow-listed fields only).
  inputHash           String             @map("input_hash")
  /// Ours, checked in SQL: pending, running, paused, completed, failed, cancelled, unknown. `unknown` is
  /// a timeout or dropped connection: the run may or may not exist on Sim.
  status              String             @default("pending")
  /// The Agent block's structured output (proposal and evidence), exactly as Sim returned it.
  output              Json?
  proposedDisposition TriageDisposition? @map("proposed_disposition")
  /// 0..1, from the proposal.
  confidence          Float?
  costUsd             Decimal?           @map("cost_usd") @db.Decimal(12, 6)
  latencyMs           Int?               @map("latency_ms")
  /// Sim's error body exactly as returned.
  error               Json?
  startedAt           DateTime?          @map("started_at") @db.Timestamptz(3)
  completedAt         DateTime?          @map("completed_at") @db.Timestamptz(3)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  lead     Lead      @relation(fields: [leadId], references: [id], onDelete: Restrict)
  crmEvent CrmEvent? @relation(fields: [crmEventId], references: [id], onDelete: SetNull)
  approval Approval?

  @@index([leadId, createdAt])
  @@index([workflowId, workflowVersion])
  @@index([status])
  @@map("agent_run")
}

/// A person's decision on one proposal. Created pending when the Human block's notification arrives;
/// the console sets the decision; the local worker resumes Sim with `simContextId` and sets `resumedAt`.
/// Nothing writes to HubSpot without an approved row. One per run (unique), so a double approve can't make two.
model Approval {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentRunId   String            @unique @map("agent_run_id") @db.Uuid
  /// The Human block's ID (Sim's `contextId`). Resume always sends runId and contextId together.
  simContextId String            @map("sim_context_id")
  /// Proposed values against the current HubSpot values, with evidence and confidence, as displayed.
  diff         Json
  /// Null while pending. Checked in SQL: decision, approver and decidedAt are set together.
  decision     ApprovalDecision?
  approver     String?
  comment      String?
  decidedAt    DateTime?         @map("decided_at") @db.Timestamptz(3)
  /// When the worker's resume call was answered (the new run ID is on AgentRun.resumeRunId).
  resumedAt    DateTime?         @map("resumed_at") @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  agentRun           AgentRun  @relation(fields: [agentRunId], references: [id], onDelete: Restrict)
  /// A rejected approval promoted to a candidate eval case (`pnpm eval promote`, Phase 6.6).
  promotedToEvalCase EvalCase?

  @@index([decision, resumedAt])
  @@map("approval")
}

/// A labelled case. The source of truth is `evals/datasets/`; this row is the copy runs point at.
model EvalCase {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stable case ID from the dataset file (`spam-003`, …); also part of the eval `X-Run-Id`.
  key                    String    @unique
  split                  EvalSplit
  /// Category from Sim's HubSpot guide or this repo's additions (`subsidiary`, `prompt_injection`, …).
  category               String
  /// The snapshot sent as workflow input (eval runs always send one, never a contact ID).
  snapshot               Json
  /// The intended labels the scorers compare against.
  expected               Json
  /// sha256 of snapshot + expected, to notice a case that changed under a recorded result.
  contentHash            String    @map("content_hash")
  promotedFromApprovalId String?   @unique @map("promoted_from_approval_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  promotedFromApproval Approval?    @relation(fields: [promotedFromApprovalId], references: [id], onDelete: SetNull)
  results              EvalResult[]

  @@index([split, category])
  @@map("eval_case")
}

/// One gate or dev run of one deployed workflow version over one split (always shadow mode).
model EvalRun {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId      String       @map("workflow_id")
  workflowVersion Int          @map("workflow_version")
  split           EvalSplit
  /// Model behind the Agent block, as configured in Sim (e.g. a Gemini Flash-Lite ID).
  model           String?
  /// Content hash of sim/lead-triage (workflow.ts + functions/) the recordings are keyed on.
  sourceHash      String       @map("source_hash")
  /// Ours, checked in SQL: running, completed, failed.
  status          String       @default("running")
  /// Aggregate metrics, named as in Sim's HubSpot guide.
  summary         Json?
  /// `evals/reports/<date>-vN.md`.
  reportPath      String?      @map("report_path")
  startedAt       DateTime     @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt     DateTime?    @map("completed_at") @db.Timestamptz(3)
  results         EvalResult[]

  @@index([workflowId, workflowVersion, split])
  @@map("eval_run")
}

/// One case in one eval run.
model EvalResult {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evalRunId  String   @map("eval_run_id") @db.Uuid
  evalCaseId String   @map("eval_case_id") @db.Uuid
  /// `eval_<evalRunId>_<caseKey>_v<N>`, the X-Run-Id sent to Sim.
  simRunId   String   @unique @map("sim_run_id")
  /// Ours, checked in SQL: completed, failed, cancelled, unknown. A run left paused is cancelled and the
  /// harness fails.
  status     String
  output     Json?
  /// Per-field scores and the deterministic scorers' verdicts.
  scores     Json     @default("{}")
  latencyMs  Int?     @map("latency_ms")
  costUsd    Decimal? @map("cost_usd") @db.Decimal(12, 6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  evalRun  EvalRun  @relation(fields: [evalRunId], references: [id], onDelete: Cascade)
  evalCase EvalCase @relation(fields: [evalCaseId], references: [id], onDelete: Restrict)

  @@unique([evalRunId, evalCaseId])
  @@map("eval_result")
}
