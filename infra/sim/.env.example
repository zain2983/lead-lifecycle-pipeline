# Self-hosted Sim (infra/sim/docker-compose.yml). Copy to infra/sim/.env, which is gitignored, and fill every
# empty value with the command next to it. Compose reads this file for interpolation and also loads it into the
# simstudio and realtime containers (env_file), which is how the preview flags below reach the app.
#
# Generate all the secrets at once:
#   for v in BETTER_AUTH_SECRET ENCRYPTION_KEY INTERNAL_API_SECRET API_ENCRYPTION_KEY CRON_SECRET; do
#     echo "$v=$(openssl rand -hex 32)"; done; echo "POSTGRES_PASSWORD=$(openssl rand -hex 24)"

# --- Version (app, realtime, migrations and cron move together) -------------------------------------
SIM_VERSION=v0.9.66

# --- Preview features --------------------------------------------------------------------------------
# Workflows as code: the block catalog, `sim workflows source get|check|apply`, the read-only Code tab.
WORKFLOW_CODE=true
# Workflow tests: the Tests page and tests/<name>.test.js files.
WORKFLOW_TESTS=true

# --- Telemetry ---------------------------------------------------------------------------------------
# The server otherwise sends anonymous traces to telemetry.simstudio.ai (apps/sim/lib/monitoring/otlp.ts).
NEXT_TELEMETRY_DISABLED=1

# --- Required secrets (compose refuses to start without them) ----------------------------------------
# openssl rand -hex 24   (applied only when the postgres_data volume is first created)
POSTGRES_PASSWORD=
# openssl rand -hex 32
BETTER_AUTH_SECRET=
# openssl rand -hex 32   (never change it after first start: stored credentials become unreadable)
ENCRYPTION_KEY=
# openssl rand -hex 32
INTERNAL_API_SECRET=

# --- Optional secrets --------------------------------------------------------------------------------
# openssl rand -hex 32   (encrypts API keys at rest; when empty Sim stores them in plain text, lib/api-key/crypto.ts)
API_ENCRYPTION_KEY=
# openssl rand -hex 32   (lets the cron container call the job endpoints: time-based resume, outbox, schedules)
CRON_SECRET=

# --- Local spike account (this instance only, synthetic) ----------------------------------------------
# Created by infra/sim/bootstrap.sh against http://localhost:3000. Never a real person or address.
SIM_LOCAL_USER_EMAIL=builder@example.com
# openssl rand -base64 24
SIM_LOCAL_USER_PASSWORD=
# Written by bootstrap.sh after it creates them.
SIM_LOCAL_WORKSPACE_ID=
SIM_LOCAL_API_KEY=
