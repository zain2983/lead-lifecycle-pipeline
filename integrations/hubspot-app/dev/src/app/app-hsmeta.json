{
  "uid": "llp_dev_app",
  "type": "app",
  "config": {
    "name": "lead-lifecycle-pipeline (dev)",
    "description": "Development app for lead-lifecycle-pipeline. Installs by OAuth into allowlisted developer test accounts and receives contact and deal webhooks. Synthetic data only.",
    "distribution": "private",
    "auth": {
      "type": "oauth",
      "redirectUrls": [
        "http://localhost:3100/api/hubspot/oauth/callback",
        "https://web-placeholder.example.com/api/hubspot/oauth/callback"
      ],
      "requiredScopes": [
        "oauth",
        "crm.objects.contacts.read",
        "crm.objects.contacts.write",
        "crm.schemas.contacts.read",
        "crm.schemas.contacts.write",
        "crm.objects.deals.read",
        "crm.objects.deals.write"
      ],
      "optionalScopes": [],
      "conditionallyRequiredScopes": []
    }
  }
}
